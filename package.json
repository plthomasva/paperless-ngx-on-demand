{
  "name": "paperless-ngx-on-demand",
  "version": "1.0.0",
  "description": "On-demand, scale-to-zero Paperless-NGX deployment on AWS with dynamic CloudFront edge routing and task-aware indexing drain watchdog",
  "type": "module",
  "bin": {
    "paperless-on-demand": "bin/paperless-on-demand.js"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "stryker": "stryker run",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "tsx scripts/deploy.ts",
    "diff": "cdk diff"
  },
  "keywords": [
    "paperless-ngx",
    "aws",
    "cdk",
    "serverless",
    "scale-to-zero",
    "cloudfront",
    "ec2",
    "fargate"
  ],
  "author": "Peter L. Thomas",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.750.0",
    "@aws-sdk/client-ec2": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-sts": "^3.750.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.5"
  }
}
